{
  "name": "coupang-deal-alerts",
  "version": "0.1.0",
  "description": "쿠팡 인기상품 중 평시보다 세게 할인하는 상품을 세부 카테고리별로 알림해주는 셀프호스팅 웹앱",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "node --no-warnings=ExperimentalWarning dist/server/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test 'src/**/*.test.ts'",
    "vapid": "tsx src/tools/gen-vapid.ts",
    "seed": "tsx src/tools/seed-fixture.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
