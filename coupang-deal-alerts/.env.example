# ---- server ----
PORT=8787
HOST=0.0.0.0
BASE_URL=http://localhost:8787
DB_PATH=./data/deals.db
TZ_NAME=Asia/Seoul

# ---- data source ----
# fixture = 합성 데모 데이터 (기본, 키 불필요) / coupang = 쿠팡 파트너스 Open API
PROVIDER_MODE=fixture
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
COUPANG_LIMIT=100
# 게이트웨이가 /v1 경로를 거부하면 /v2/providers/affiliate_open_api/apis/openapi 로 변경
# COUPANG_API_PREFIX=/v2/providers/affiliate_open_api/apis/openapi/v1
POLL_INTERVAL_MIN=60
MIN_REQUEST_SPACING_MS=3000
SCHEDULER_ENABLED=true

# ---- web push (npm run vapid) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- telegram (optional) ----
TELEGRAM_BOT_TOKEN=

# ---- admin ----
ADMIN_TOKEN=change-me
